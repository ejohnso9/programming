    1. CLI/'subprocess' via: std::cin, std::cout

#-----------------------------------------------------------------------
# Python
import subprocess

def run_cpp_program(input_value):
    # Run compiled executable and capture output
    result = subprocess.run(
        ['./my_program'],  # replace with your compiled executable
        input=f"{input_value}\n", 
        text=True, 
        capture_output=True
    )
    return result.stdout.strip()

# Test cases
assert run_cpp_program(2) == "4"
assert run_cpp_program(5) == "25"
print("All tests passed!")
#-----------------------------------------------------------------------

    2. Wrap C++ code as Python module
    # module: pybind11  # prefer this
    # boost:: python    # previosly read of issues w/ this?

//----------------------------------------------------------------------
// C++
int square(int x) {
    return x * x;
}
//----------------------------------------------------------------------


//----------------------------------------------------------------------
// C++
#include <pybind11/pybind11.h>

int square(int x) { return x * x; }

PYBIND11_MODULE(my_module, m) {
    m.def("square", &square, "Compute square of an integer");
}
//----------------------------------------------------------------------


# Compile using g++ and pybind11 installed
$ c++ -O3 -Wall -shared -std=c++17 -fPIC $(python3 -m pybind11 --includes) bindings.cpp -o my_module$(python3-config --extension-suffix)


#-----------------------------------------------------------------------
# Python
import my_module

assert my_module.square(3) == 9
assert my_module.square(10) == 100
print("All tests passed!")
#-----------------------------------------------------------------------


    3. 'ctypes' or 'cffi'
    # compile code in shared library (.so or .dll)

    # ctypes example...
    // C++
    extern "C" int square(int x) {
        return x * x;
    }

    # bash
    $ g++ -shared -fPIC -o libexample.so libexample.cpp



Practical advice for testing “normal” C++ code from Python

    - Start simple: If your code is already an executable, use subprocess first.
    You can get a lot of testing done with minimal effort.

    - Use Python’s testing ecosystem: Combine unittest or pytest with subprocess calls.

    - Expose key functions via pybind11 if you need to test internal logic frequently or require fast iteration.

    - Keep tests independent: Avoid relying on global state in C++ — makes Python testing easier.

    - Handle I/O carefully: Python can simulate input files, stdin, or arguments using subprocess.


# Here's ChatGPT simply pybind11 example...
// bindings.cpp
#include <pybind11/pybind11.h>

int square(int x) { return x * x; }

namespace py = pybind11;

PYBIND11_MODULE(my_module, m) {
    m.def("square", &square, "Compute the square of a number");
}

# Will need pybind11 installed via pip: pip install pybind11

# bash
c++ -O3 -Wall -shared -std=c++17 -fPIC \
    $(python3 -m pybind11 --includes) \
    bindings.cpp -o my_module$(python3-config --extension-suffix)


# Wrapping an entire C++ class
// C++
// counter.cpp
#include <pybind11/pybind11.h>

class Counter {
    int value;
public:
    Counter(int v=0) : value(v) {}
    void increment() { ++value; }
    int get() const { return value; }
};

namespace py = pybind11;

PYBIND11_MODULE(my_module, m) {
    py::class_<Counter>(m, "Counter")
        .def(py::init<int>())
        .def("increment", &Counter::increment)
        .def("get", &Counter::get);
}




2.2, pg23
----------
use: . to access members through a name or reference
     -> to access members through a pointer
     (see example bottom of sec 2.2)

class Vector {
public:
    // pg24: The constructor initilizes the Vector members using a
    member initilizer list: (starting w/ :elem
    Vector(int s) :elem{new double[s]}, sz{s} { } // construct a Vector
    double& operator[](int i) { return elem[i]; }  // element acess: subscripting
    int size() { return sz; }
private:
    double* elem; // pointer to the elements
    int sz;       // the number of elements
}
// see section 4.2.2 for destructor use
    

