2.4 Unions
----------
    union Value {
        // one or the other in use here, never both (and the union
        // itself does not keep track: up to programmer to mamange that)
        node* p;
        int i;
    };

    pg 26
    // "correspondence between a 'type' field (t) and the type held in a
    // union is error-prone."
    // "The use of naked unions is best minimized.": see standard
    // library type: 'variant' (@see sec 13.5.1)

    // Entry could be def as:
    struct Entry {
        string name;
        variant<Node*,int> v;
    }

    // usage
    void f(Entry * pe) {
        if (holds_alternative<int>(pe->v)) // does *pe hold an int? (sec 13.5.1)
            cout << get<int>(pe->v);       // get the int
        // ...
    }
    // "For many uses, a variant is simple and safer to use than a union."


2.5 Enumerations
    // used to represent small sets of int values
-----------------
    // def
    enum class Color { red, blue, green };
    enum class Traffic_light { green, yellow, red };

    // use
    Color col = Color::red;
    Traffic_light light = Traffic_light::red;

    // Traffic_light and Color are separate classes: cannot be intermixed
    // ERROR examples:
    Traffic_light stop = Color:red;  // ERROR!!!
    int color = Color:red;  // ERROR: Color is not int!
    Color c = 2;  // ERROR: Color is not int!

    // OK
    Color x = Color{2} // verbos
    Color y {1}; // blue, I assume?

    // pg 27: plain enum
    enum Color { red, green, blue }
    int col = green;  // col == 1


